{
  "name": "cjm-lite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --var APP_ENV:development --var APP_URL:http://localhost:8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "bootstrap": "node scripts/bootstrap.mjs",
    "migrate:data": "python3 scripts/migrate-sqlite-to-d1/export.py",
    "predev": "node scripts/local-env.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261007.1",
    "vitest": "~4.1.0",
    "typescript": "^5.9.0",
    "wrangler": "4.148.0",
    "@cloudflare/vitest-plugin": "1.3.7",
    "playwright": "1.63.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
